  "outer_validation_fraction": 0.2,
  "statistics_dtype": "float32",
  "solver_dtype": "float32",
  "widths": [2000, 4000, 6000, 8000, 10000],
  "ranpac": {
    "upstream_repository": "https://github.com/McDonnell-Research-Lab/RanPAC",
